---
const navItems = [
  { href: "#home", id: "Home", en: "Home" },
  { href: "#about", id: "Profil", en: "Profile" },
  { href: "#skills", id: "Keahlian", en: "Skills" },
  { href: "#projects", id: "Project", en: "Projects" },
  { href: "#contact", id: "Kontak", en: "Contact" },
];

const whatsappUrl = "https://wa.me/62895321205351";
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50 px-3 pt-4 sm:px-6 lg:px-8">
  <nav
    aria-label="Primary navigation"
    class="pointer-events-auto mx-auto grid h-16 max-w-[1180px] grid-cols-[1fr_auto] items-center gap-3 rounded-[18px] border border-white/[0.08] bg-charcoal/78 px-3 shadow-[0_18px_60px_rgba(0,0,0,0.32)] backdrop-blur-xl lg:grid-cols-[1fr_auto_1fr] lg:px-4"
  >
    <a
      href="/"
      aria-label="Jakkob Panjaitan - Home"
      class="group flex min-w-0 items-center gap-3 justify-self-start rounded-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-soft"
    >
      <span class="relative flex size-10 items-center justify-center overflow-hidden rounded-xl border border-gold/35 bg-gold/[0.08] font-mono text-[12px] font-semibold tracking-[0.16em] text-gold-soft transition-colors duration-300 group-hover:border-gold/60 group-hover:text-ivory">
        <span class="absolute inset-x-2 top-0 h-px bg-gold-soft/60"></span>
        JP
      </span>

      <span class="flex min-w-0 flex-col">
        <span class="truncate font-display text-[18px] leading-none text-ivory sm:text-[20px]">
          Jakkob
        </span>
        <span
          class="hidden font-mono text-[9px] font-medium uppercase tracking-[0.18em] text-muted sm:block"
          data-i18n-id="Fullstack Web Developer"
          data-i18n-en="Fullstack Web Developer"
        >
          Fullstack Web Developer
        </span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 rounded-full border border-white/[0.06] bg-white/[0.025] p-1 lg:flex">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="group relative inline-flex rounded-full px-4 py-2 text-[12px] font-medium text-bone/70 transition-all duration-300 hover:bg-white/[0.045] hover:text-ivory focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-soft"
            >
              <span data-i18n-id={item.id} data-i18n-en={item.en}>{item.id}</span>
              <span class="absolute inset-x-4 bottom-1 h-px scale-x-0 bg-gold/75 transition-transform duration-300 group-hover:scale-x-100" />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2 justify-self-end">
      <button
        type="button"
        data-lang-toggle
        aria-label="Switch language"
        class="hidden h-10 items-center rounded-full border border-white/[0.08] bg-white/[0.035] p-1 font-mono text-[10px] font-semibold uppercase text-muted transition-colors duration-300 hover:border-gold/35 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-soft sm:inline-flex"
      >
        <span data-lang-id class="rounded-full bg-gold px-2.5 py-1.5 text-obsidian">ID</span>
        <span data-lang-en class="rounded-full px-2.5 py-1.5 text-bone/70">EN</span>
      </button>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noreferrer"
        class="hidden h-10 items-center gap-2 rounded-full border border-gold/30 bg-gold/[0.08] px-4 text-[12px] font-semibold text-ivory transition-all duration-300 hover:border-gold/55 hover:bg-gold/[0.14] hover:text-gold-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-soft md:inline-flex"
      >
        <span data-i18n-id="Diskusi Project" data-i18n-en="Discuss Project">Diskusi Project</span>
        <span aria-hidden="true" class="font-mono text-gold-soft">-></span>
      </a>

      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-navigation"
        class="inline-flex h-10 items-center gap-2 rounded-full border border-white/[0.1] bg-white/[0.035] px-4 text-[12px] font-medium text-bone transition-colors duration-300 hover:text-ivory focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-soft lg:hidden"
      >
        <span data-menu-label data-i18n-id="Menu" data-i18n-en="Menu">Menu</span>
        <span class="flex w-4 flex-col gap-1" aria-hidden="true">
          <span class="h-px w-full bg-current"></span>
          <span class="h-px w-full bg-current"></span>
        </span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-navigation"
    data-mobile-nav
    aria-label="Mobile navigation"
    class="pointer-events-auto mx-auto mt-2 hidden max-w-[1180px] rounded-[18px] border border-white/[0.08] bg-charcoal/95 p-2 shadow-[0_18px_60px_rgba(0,0,0,0.32)] backdrop-blur-xl lg:hidden"
  >
    <div class="flex flex-col gap-1">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-i18n-id={item.id}
            data-i18n-en={item.en}
            class="rounded-xl px-4 py-3 text-sm font-medium text-bone transition-colors duration-300 hover:bg-white/[0.05] hover:text-ivory focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-soft"
          >
            {item.id}
          </a>
        ))
      }

      <button
        type="button"
        data-lang-toggle
        aria-label="Switch language"
        class="mt-1 flex items-center justify-between rounded-xl border border-white/[0.08] bg-white/[0.035] px-4 py-3 font-mono text-xs font-semibold uppercase text-bone transition-colors duration-300 hover:border-gold/35 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-soft sm:hidden"
      >
        <span>Language</span>
        <span class="flex rounded-full border border-white/[0.08] p-1">
          <span data-lang-id class="rounded-full bg-gold px-2.5 py-1 text-obsidian">ID</span>
          <span data-lang-en class="rounded-full px-2.5 py-1 text-bone/70">EN</span>
        </span>
      </button>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noreferrer"
        class="mt-1 flex items-center justify-between rounded-xl border border-gold/25 bg-gold/[0.08] px-4 py-3 text-sm font-semibold text-gold-soft transition-colors duration-300 hover:border-gold/50 hover:bg-gold/[0.12] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-soft"
      >
        <span data-i18n-id="Diskusi Project" data-i18n-en="Discuss Project">Diskusi Project</span>
        <span aria-hidden="true" class="font-mono">-></span>
      </a>
    </div>
  </div>
</header>

<script>
  const setupNavbar = () => {
    const toggle = document.querySelector("[data-nav-toggle]");
    const panel = document.querySelector("[data-mobile-nav]");
    const langToggles = document.querySelectorAll("[data-lang-toggle]");
    const translatable = document.querySelectorAll("[data-i18n-id][data-i18n-en]");

    const getLanguage = () => {
      const stored = window.localStorage.getItem("portfolio-language");
      return stored === "en" ? "en" : "id";
    };

    const setLanguage = (language) => {
      const lang = language === "en" ? "en" : "id";

      document.documentElement.lang = lang;
      window.localStorage.setItem("portfolio-language", lang);

      translatable.forEach((item) => {
        if (!(item instanceof HTMLElement)) return;
        item.textContent = item.dataset[`i18n${lang === "id" ? "Id" : "En"}`] ?? item.textContent;
      });

      langToggles.forEach((button) => {
        const idLabel = button.querySelector("[data-lang-id]");
        const enLabel = button.querySelector("[data-lang-en]");

        idLabel?.classList.toggle("bg-gold", lang === "id");
        idLabel?.classList.toggle("text-obsidian", lang === "id");
        idLabel?.classList.toggle("text-bone/70", lang !== "id");

        enLabel?.classList.toggle("bg-gold", lang === "en");
        enLabel?.classList.toggle("text-obsidian", lang === "en");
        enLabel?.classList.toggle("text-bone/70", lang !== "en");
      });

      window.dispatchEvent(new CustomEvent("portfolio:language-change", { detail: { language: lang } }));
    };

    setLanguage(getLanguage());

    langToggles.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      if (button.dataset.langReady === "true") return;

      button.dataset.langReady = "true";
      button.addEventListener("click", () => {
        setLanguage(getLanguage() === "id" ? "en" : "id");
      });
    });

    if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;
    if (toggle.dataset.navReady === "true") return;

    toggle.dataset.navReady = "true";

    const links = panel.querySelectorAll("a");

    const setOpen = (open) => {
      toggle.setAttribute("aria-expanded", String(open));
      panel.classList.toggle("hidden", !open);
    };

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      setOpen(!isOpen);
    });

    links.forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
  };

  document.addEventListener("astro:page-load", setupNavbar);
  if (document.readyState !== "loading") setupNavbar();
  else document.addEventListener("DOMContentLoaded", setupNavbar);
</script>
